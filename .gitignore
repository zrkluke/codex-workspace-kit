# Excel workbooks are versioned by filename in 02-workbench/ and documented in changelogs.
*.xlsx
*.xlsm
*.xls
~$*
node_modules/

# Keep synthetic example workbooks tracked.
!00-examples/**/*.xlsx
00-examples/**/~$*.xlsx

# Local workbench logs and reports are user/project-specific.
02-workbench/**/CHANGELOG.md
02-workbench/reports/*.md

# Keep folder placeholders.
!.gitkeep

# Keep example changelogs tracked as format references.
!00-examples/**/CHANGELOG.md

